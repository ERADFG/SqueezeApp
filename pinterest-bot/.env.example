# Copy to .env (never commit it). On a host, set these as the service's environment variables instead.
# Free hosting without a VPS: see FREE_HOSTING.md (GitHub Actions). Set RUN_ONCE=1 there; BOARD_ID is optional.
BOARD_ID=
PINTEREST_ACCESS_TOKEN=
# Needed for true 24/7: tokens expire, and these let the bot renew its own token.
PINTEREST_REFRESH_TOKEN=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Sandbox (pins only visible to you). Use https://api.pinterest.com/v5 after Standard access is approved.
PINTEREST_API_BASE=https://api-sandbox.pinterest.com/v5
# At least 12 characters if the admin page is reachable from the internet.
ADMIN_PASSWORD=
SITE_URL=https://interactink.com
HOST=127.0.0.1
PORT=3000
